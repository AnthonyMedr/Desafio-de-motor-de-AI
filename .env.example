
PORT=3000
DATABASE_PATH=./data/atendimento.sqlite
TENANTS_DIR=./tenants
BURST_WINDOW_MS=8000
WORKER_INTERVAL_MS=250

#Para Gemini (modelo utilizado nos testes), defina LLM_PROVIDER=gemini e informe sua chave.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=30000
LLM_TURN_TIMEOUT_MS=120000
LLM_MAX_ROUNDS=8
LLM_MAX_RETRIES=1
MAX_JOB_ATTEMPTS=3

# USD por milhão de tokens; preços de referência
INPUT_USD_PER_MILLION=0.30
OUTPUT_USD_PER_MILLION=2.50
